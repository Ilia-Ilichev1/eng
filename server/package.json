{
  "name": "eng-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express + SQLite backend for the English learning app",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon --max-old-space-size=256 src/index.js",
    "start": "node --max-old-space-size=256 src/index.js",
    "seed": "node --max-old-space-size=256 src/seed/seed.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node -e \"console.log('no build step; server runs from src')\""
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
